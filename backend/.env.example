# ================= DmfDataAgent 环境配置示例 =================
# 复制为 .env 后按需修改；所有配置项均带默认值，未配置的模块自动降级：
#   - LLM 未配置       -> Agent 走规则/模板降级路径（意图/要素/答复），链路仍可跑通
#   - StarRocks 未配置 -> 指标取数明确报错（不返回假数据），答复中如实说明
#   - MySQL 未配置     -> 会话/消息/知识库降级为内存存储
#   - 观测             -> 遵循 OpenTelemetry，span 落 trace_spans + 轮级 trace_records（前端"运行观测"页数据源）
#   - RAG 未配置       -> 知识库问答降级为 BM25 纯关键词检索
# 配置读取规则：前缀 DMF_ + 连字符分层，例如 DMF_LLM-MODEL 对应 llm.model

# ---------- 应用 ----------
DMF_APP-HOST=0.0.0.0
DMF_APP-PORT=8000
DMF_APP-DEBUG=false

# ---------- LLM（OpenAI 兼容协议，覆盖 qwen/dashscope、zhipu、deepseek、vllm、ollama 等） ----------
# 对话 LLM 推荐在管理端「模型管理」页配置（入库 llm_configs，默认模型运行时生效，支持连接测试）。
# 首次启动若下方 env 配了 chat LLM 而库内无默认模型，会幂等引导为库内默认模型，之后即可删下方键。
# 下方键仅作「未设库内默认模型」时的环境变量兜底；平时可整段留空。
# DMF_LLM-MODEL=qwen2.5-72b-instruct
# DMF_LLM-BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DMF_LLM-API_KEY=
# DMF_LLM-TEMPERATURE=0.1
# DMF_LLM-TIMEOUT=120

# ---------- 模型管理（对话 LLM 配置入库；默认模型覆盖上面的 DMF_LLM-* 生效） ----------
# 模型管理页配置的 is_default 且 enabled 条目作为运行时生效模型，覆盖 DMF_LLM-*；
# 未配置默认模型时回落环境变量。probe_interval_s：后台探活周期（多实例收敛），0 = 关。
DMF_MODEL-PROBE_INTERVAL_S=30.0

# Embedding（用于 RAG 与相似度召回）
# 向量化模型单独部署为 embedding-service（见仓库 embedding-service/，OpenAI 兼容 /v1/embeddings 接口）。
# 应用通过 HTTP 调用该接口；上线生产时改 DMF_LLM-EMBEDDING_BASE_URL 指向生产小模型服务（同为 OpenAI 兼容）即可，代码不变。
# 后端（DMF_LLM-EMBEDDING_BACKEND）：
#   openai : 【生产/推荐】调用 OpenAI 兼容嵌入服务（本项目 embedding-service 或生产小模型），只需 MODEL+BASE_URL，API_KEY 可选（自托管免鉴权）
#   local  : 【开发兜底】进程内 LangChain HuggingFaceEmbeddings 本地推理，不依赖任何服务
DMF_LLM-EMBEDDING_BACKEND=local
# 本地模式（backend=local 时生效）：本地模型名，1024 维中文优化；可换成其它本地模型
DMF_LLM-EMBEDDING_LOCAL_MODEL=BAAI/bge-large-zh
# DMF_LLM-EMBEDDING_LOCAL_CACHE_FOLDER=   # 离线模型目录；留空用默认缓存目录
# DMF_LLM-EMBEDDING_LOCAL_DEVICE=cpu      # cpu / cuda / mps
# 服务调用模式（backend=openai 时生效）：指向本项目 embedding-service（docker 内为 http://embedding:8001/v1）
DMF_LLM-EMBEDDING_MODEL=bge-large-zh
DMF_LLM-EMBEDDING_BASE_URL=http://localhost:8001/v1
DMF_LLM-EMBEDDING_API_KEY=
# openai 后端容错（backend=openai 时生效）
DMF_LLM-EMBEDDING_RETRY=2                       # 嵌入服务调用失败的重试次数（指数退避）
DMF_LLM-EMBEDDING_FALLBACK_TO_LOCAL=true        # 主后端持续失败时降级到进程内本地模型（需与远端同维度；权重须在 app 容器内可用）

# ---------- MySQL ----------
DMF_DB-ENABLED=true
DMF_DB-HOST=127.0.0.1
DMF_DB-PORT=3306
DMF_DB-USER=dmf_agent
DMF_DB-PASSWORD=dmf_agent
DMF_DB-DATABASE=dmf_agent
# 开发环境启动时自动建表（生产环境请改用 alembic 迁移）
DMF_DB-AUTO_CREATE_TABLES=true

# ---------- 观测（遵循 OpenTelemetry：span 落库 trace_spans + 轮级 trace_records） ----------
# 不接任何外部观测平台（agent-insight / Langfuse / OTLP collector 均已移除）。
# 一轮对话 = 一条 root span（chat_round），每个图节点 = 一条子 span（node.<name>）；
# 前端"运行观测"页读 /api/v1/obs/*，数据全部来自本地库。
DMF_OBSERVABILITY-ENABLED=true
DMF_OBSERVABILITY-SERVICE_NAME=dmf-agent
# span 属性字符串截断长度 / 单轮 span 数上限（防御性）
DMF_OBSERVABILITY-MAX_ATTRIBUTE_LENGTH=2048
DMF_OBSERVABILITY-MAX_SPANS_PER_ROUND=64

# ---------- 会话留痕（合规审计；每轮 trace 落盘 {dir}/{session_id}/{round_id}.json） ----------
# 生产建议挂独立数据卷并配绝对路径；置 false 或留空目录则只落库不落盘
DMF_SESSION-ARCHIVE_ENABLED=true
DMF_SESSION-ARCHIVE_DIR=data/sessions

# ---------- 会话级串行化闸（同一 session_id 的对话轮次互斥；Redis 异常时自动降级为进程内锁） ----------
# 关闭后并发轮次可能交错落库/重复压缩；仅调试用
DMF_SESSION-LOCK_ENABLED=true
# 等锁上限（秒）：<= 0 表示不等待、立即可判「会话忙」；正数给一个短暂缓冲
DMF_SESSION-LOCK_WAIT_SECONDS=2.0
# Redis 分布式锁 TTL（秒）：需大于单轮最长耗时（LLM 超时×重试+取数），否则锁会中途过期
DMF_SESSION-LOCK_TTL_SECONDS=600

# ---------- RAG 知识库（默认 Milvus/HNSW，对齐老系统；需 pip install -e '.[milvus]'） ----------
# 向量后端：milvus（默认）| faiss（零依赖本地，需 pip install -e '.[rag]'）；未装依赖时自动降级纯 BM25
DMF_RAG-BACKEND=milvus
# Milvus：测试/本地用内嵌库文件（免 Docker）；生产改成 Milvus server，如 http://172.22.20.134:19530
DMF_RAG-MILVUS_URI=data/milvus.db
DMF_RAG-MILVUS_TOKEN=
DMF_RAG-COLLECTION_NAME=dmf_agent_kb
# FAISS 后端的本地持久化目录（backend=faiss 时使用）
DMF_RAG-PERSIST_DIR=data/vector_store
DMF_RAG-TOP_K=4
# 切分对齐老系统 knowledge_service：块 500，重叠 20% = 100
DMF_RAG-CHUNK_SIZE=500
DMF_RAG-CHUNK_OVERLAP=100

# ---- 知识检索两阶段（FR7）：先召回（BM25+向量 RRF），再 cross-encoder 精排 ----
# 精排模型由 embedding-service 承载（同进程 /v1/rerank），应用只做 HTTP 调用。
# 关闭 / 服务不可用 / 调用失败 一律优雅降级为纯 RRF 顺序，知识问答不受影响。
DMF_RAG-RERANK_ENABLED=true
# 留空则自动复用 DMF_LLM-EMBEDDING_BASE_URL + /rerank；也可指向商用 rerank API
DMF_RAG-RERANK_BASE_URL=
DMF_RAG-RERANK_MODEL=bge-reranker-base
DMF_RAG-RERANK_API_KEY=
# 送入精排的候选数（越大越全但越慢）；最终仍按 TOP_K 返回
DMF_RAG-RERANK_TOP_N=20
DMF_RAG-RERANK_TIMEOUT=20.0
# 来源分级权重（最终分 = 精排/RRF 分 × 权重）：权威源 > 沉淀源 > 用户上传
DMF_RAG-AUTHORITY_WEIGHTS={"authoritative": 1.5, "sediment": 1.15, "user": 1.0}

# ---------- 指标候选召回（full/black_talk/part 三路融合 + 分层加权 + 相对阈值） ----------
DMF_RECALL-MIN_SCORE=0.5
DMF_RECALL-MAX_NUMS=20
# 融合分层权重（对齐老系统 weight_sort：full=1.0 / embed=0.6 / part=0.4）
DMF_RECALL-WEIGHT_FULL=1.0
DMF_RECALL-WEIGHT_BLACK_TALK=1.0
DMF_RECALL-WEIGHT_EMBED=0.6
DMF_RECALL-WEIGHT_PART=0.4
# 相对阈值过滤（有强命中时抑制低分部分匹配噪声；对齐老 >= 最高分/3）
DMF_RECALL-ENABLE_RELATIVE_THRESHOLD=true
DMF_RECALL-RELATIVE_THRESHOLD_RATIO=0.333
# 向量召回（embedding 服务，Phase 5 启用）
DMF_RECALL-ENABLE_EMBEDDING=false

# ---------- StarRocks（主流程唯一取数出口：语义层 -> MetricFlow 编译 -> StarRocks） ----------
# 指标与维度的元信息来自语义清单 backend/dmf_agent/semantic/manifest.yml（不经指标平台）；
# 编译出的 SQL 通过 FE 的 MySQL 协议端口（默认 9030）直连执行。
# 示例底表与造数脚本见 deploy/starrocks/（dws_trade_day / dws_user_day）。
DMF_STARROCKS-HOST=
DMF_STARROCKS-PORT=9030
DMF_STARROCKS-USER=root
DMF_STARROCKS-PASSWORD=
DMF_STARROCKS-DATABASE=
# 连接/查询参数
DMF_STARROCKS-CHARSET=utf8mb4
DMF_STARROCKS-CONNECT_TIMEOUT=10
DMF_STARROCKS-QUERY_TIMEOUT=60
DMF_STARROCKS-POOL_MIN_SIZE=1
DMF_STARROCKS-POOL_MAX_SIZE=5
# 结果集行数上限（超出即截断并在结果中标注 truncated）
DMF_STARROCKS-MAX_ROWS=200000
# 跨语义模型的 JOIN 方式：full（FULL OUTER JOIN，默认）| left（主模型驱动）
DMF_STARROCKS-JOIN_TYPE=full
# 时间列输出别名（编译 SQL 中分组时间维度的列名）
DMF_STARROCKS-TIME_COLUMN_ALIAS=date
# 维度维值反查（过滤条件候选召回）：开启后抽取阶段会 SELECT DISTINCT 维度列
DMF_STARROCKS-ENABLE_DIM_VALUE_RECALL=false
DMF_STARROCKS-DIM_VALUE_RECALL_LIMIT=20
DMF_STARROCKS-DIM_VALUE_RECALL_CACHE_TTL=300
# SQL 方言：starrocks（默认，date_trunc/FULL OUTER JOIN/add_months）
#           ｜mysql（本地复用 MySQL 跑同链路，自动改写为 DATE/STR_TO_DATE/DATE_ADD/LEFT JOIN）
#           （默认 starrocks；本地无真实 StarRocks 时可设 mysql，详见 deploy/local/README.md）
DMF_STARROCKS-DIALECT=starrocks

# ---------- 指标平台（HM）—— 已移出主流程 ----------
# 仅 dmf_agent/integrations/metric_platform 使用（离线元信息导入 / 历史取数适配），
# 主流程（agents / semantic / api）不再引用；保留配置以便后续"从指标平台拉元信息到语义层"的功能开发。
# api_base：HM 网关基础地址（内部直连 http://host:port，或 nginx 转发 https://host/api/metricx）
DMF_HM-API_BASE=
DMF_HM-TIMEOUT=30
# 租户鉴权（二选一）：Access-Token（nginx 模式）或 tenant_id/user_account/user_name（内部 X_tenant 模式）
DMF_HM-ACCESS_TOKEN=
DMF_HM-TENANT_ID=
DMF_HM-USER_ACCOUNT=
DMF_HM-USER_NAME=

# ---------- 认证与权限（JWT Bearer + 租户/角色） ----------
# enabled=true：/api/v1 全站鉴权（/auth/login、/health 豁免），未登录返回 401。
# 首次启动无用户时自动引导：默认租户(default) + 管理员(admin/admin123，可改)。
DMF_AUTH-ENABLED=true
# 生产必须替换为随机长串（>=32 字节），否则旧令牌可被伪造
DMF_AUTH-JWT_SECRET=dmf-agent-dev-secret-change-me-in-production-32bytes
DMF_AUTH-JWT_ALGORITHM=HS256
# 访问令牌有效期（分钟）
DMF_AUTH-ACCESS_TOKEN_TTL_MINUTES=720
# 刷新令牌有效期（天）：access 过期时前端用 refresh 静默换新（滚动轮换，同时下发新的 refresh）
DMF_AUTH-REFRESH_TOKEN_TTL_DAYS=14
# 启动引导（仅当 users 表为空时创建）
DMF_AUTH-DEFAULT_TENANT_CODE=default
DMF_AUTH-DEFAULT_TENANT_NAME=默认租户
DMF_AUTH-DEFAULT_ADMIN_USERNAME=admin
DMF_AUTH-DEFAULT_ADMIN_PASSWORD=admin123
DMF_AUTH-PASSWORD_MIN_LENGTH=6

# ---------- P0-1 Harness 强约束（PRD FR15：工具白名单/参数校验/循环控制/超时/审计） ----------
DMF_HARNESS-ENABLED=true
# 仅白名单内节点动作可执行（execute_query/analyze_data/diagnose_data/retrieve_knowledge/...）
DMF_HARNESS-ENFORCE_WHITELIST=true
# 单轮最大 ReAct 轮数 / 工具调用次数（超过即 HARNESS_* 拦截，返回 error，主链路不中断）
DMF_HARNESS-MAX_ROUNDS=10
DMF_HARNESS-MAX_TOOL_CALLS=20
# token 预算（0=不限）；节点级超时秒（0=不限）
DMF_HARNESS-TOKEN_BUDGET=0
DMF_HARNESS-NODE_TIMEOUT_SECONDS=0
# 强制埋点（每次工具调用写 audit_logs）+ 危险输出沙箱
DMF_HARNESS-FORCE_TELEMETRY=true
DMF_HARNESS-SANDBOX_ENABLED=true
# Skill 执行沙箱（FR14）：上传 zip 整包与包内脚本的执行限额
DMF_HARNESS-SKILL_MAX_FILE_BYTES=262144
DMF_HARNESS-SKILL_MAX_STEPS=8
# zip 整包解压后的总大小上限（字节）/ 文件数上限
DMF_HARNESS-SKILL_MAX_PACKAGE_BYTES=5242880
DMF_HARNESS-SKILL_MAX_PACKAGE_FILES=100
# 包内脚本（run_skill_script）单次超时秒 / stdout+stderr 各自输出上限（字节）
DMF_HARNESS-SKILL_SCRIPT_TIMEOUT_SECONDS=30
DMF_HARNESS-SKILL_SCRIPT_MAX_OUTPUT_BYTES=65536

# ---------- P0-2 合规安全（PRD FR13：输入/输出过滤 + 脱敏 + 权限审计 + 全链路留痕） ----------
DMF_SECURITY-ENABLED=true
# 输入侧：提示注入 / 越权意图 / 敏感词 / 超长（命中直接短路，不进主图）
DMF_SECURITY-INPUT_GUARD_ENABLED=true
# 输出侧：LLM 输出内容安全过滤 + PII 脱敏（手机号/身份证/银行卡/邮箱）
DMF_SECURITY-OUTPUT_GUARD_ENABLED=true
# 结果集按敏感列名自动脱敏（客户号/手机号/证件号/银行卡/邮箱）
DMF_SECURITY-DESENSITIZE_ENABLED=true
# 权限模式：audit=只记录越权风险不拦截（P0-2）；enforce=真正拦截/过滤（P6 切换）
DMF_SECURITY-PERMISSION_MODE=audit
# 追加敏感词（逗号分隔，与内置规则合并）
DMF_SECURITY-SENSITIVE_WORDS=
DMF_SECURITY-MAX_INPUT_LENGTH=4096

# ---------- P0-5 报错分析处理（PRD FR6：错误分类 1xxx–5xxx + 限次自动修复重试 + 样本池） ----------
DMF_RECOVERY-ENABLED=true
# 解析类（LLM -> 规则兜底）最多重试次数（含首次 LLM 共 2 次）
DMF_RECOVERY-MAX_RETRIES=2
# 数据源瞬时失败（连接/查询超时）重试次数
DMF_RECOVERY-DATASOURCE_MAX_RETRIES=2
# 重试之间的退避间隔（秒）
DMF_RECOVERY-BACKOFF_SECONDS=0.3

# ---------- P1-2 Sub-Agent 编排（PRD FR10：Orchestrator–Worker + 并行调度 + 超时回收 + 深度/并发护栏） ----------
DMF_SUBAGENT-ENABLED=true
# 是否把 subagent_dispatch 节点接入主图拓扑（默认 false：不影响既有单图链路/回归测试）
DMF_SUBAGENT-WIRE_INTO_GRAPH=false
# 子任务并行上限（Semaphore）
DMF_SUBAGENT-MAX_CONCURRENCY=4
# 子任务递归深度上限（深度 > 该值直接 skipped）
DMF_SUBAGENT-MAX_DEPTH=2
# 单个子任务执行超时（秒），超时回收为 timeout 态
DMF_SUBAGENT-SUBTASK_TIMEOUT_SECONDS=20
# 单次编排派发的子任务数量上限，超出部分 skipped
DMF_SUBAGENT-MAX_SUBTASKS=6

# ---------- FR14 声明式 Skill 接入主图（对话内触发已上传的 skill 包） ----------
DMF_SKILL-ENABLED=true
# 是否把 execute_skill 节点接入主图拓扑（默认 true；未注册任何 skill 时节点完全透传，
# 拓扑行为与接线前一致，回归安全）
DMF_SKILL-WIRE_INTO_GRAPH=true
# 模型驱动优先（默认 true，对齐 Claude Code/Codex）：LLM 从已上传 skill 清单（名 + 描述）里选，
# 命中即触发；模型返回 none / 调用失败 / 无 LLM 时回落 triggers 确定性命中（守住降级矩阵）
DMF_SKILL-MODEL_DRIVEN=true
# 仅 model_driven=false 旧模式下生效：triggers 未命中后是否再用 LLM 兜底选
DMF_SKILL-MATCH_LLM_FALLBACK=true
# 包内脚本（run_skill_script）是否允许执行；false = 一律拒绝并明确报错
DMF_SKILL-SCRIPT_ENABLED=true
# zip 整包落盘根目录（SKILL.md + 脚本 + 文档，原子落盘到 {dir}/{name}/）
DMF_SKILL-PACKAGE_DIR=data/skills
# 单次执行限额见上文 DMF_HARNESS-SKILL_MAX_FILE_BYTES / DMF_HARNESS-SKILL_MAX_STEPS
# 包体与脚本限额见 DMF_HARNESS-SKILL_MAX_PACKAGE_BYTES / DMF_HARNESS-SKILL_MAX_PACKAGE_FILES /
# DMF_HARNESS-SKILL_SCRIPT_TIMEOUT_SECONDS / DMF_HARNESS-SKILL_SCRIPT_MAX_OUTPUT_BYTES

# ---------- FR11 成本计价与预算（可观测：按模型/用户/租户/意图归集） ----------
DMF_COST-ENABLED=true
# 币种标识（仅展示用；单价数值单位统一为「每 100 万 token」）
DMF_COST-CURRENCY=CNY
# 模型单价表（JSON）：键=模型名（精确匹配优先，其次最长前缀匹配，最后回落兜底价）
DMF_COST-PRICE_TABLE={}
# 未在单价表命中时的兜底单价（每 100 万 token）
DMF_COST-DEFAULT_INPUT_PRICE=2.0
DMF_COST-DEFAULT_OUTPUT_PRICE=8.0
# 日 / 月预算上限（0 = 不限制）；累计达 alert_ratio 比例告警，超 100% 标记 exceeded
DMF_COST-DAILY_BUDGET=0
DMF_COST-MONTHLY_BUDGET=0
DMF_COST-ALERT_RATIO=0.8

# ---------- Agent 主流程通用阈值（FR1/FR4） ----------
# 要素识别低置信阈值：低于该值且已识别到指标时反问澄清（0~1，越大越严格）
DMF_AGENT-LOW_CONFIDENCE_THRESHOLD=0.5
# 模型上下文窗口大小（token）：对话窗口「上下文占比圆环」的分母，按实际接入模型改（32k/64k/128k）
DMF_AGENT-CONTEXT_WINDOW_TOKENS=32768

# ---------- 语义层定义来源（混合方案：YAML 基座 manifest.d / DB 发布快照） ----------
# 定义来源：yaml=读 manifest.d 多层目录（默认）；db=读 DB 快照
# （无快照 / 反序列化失败 / 仓储异常均自动回落 yaml，取数不受影响）
# db 源的解析规则：先解「全局链」，再把该租户的 overlay 快照叠加其上；
# 租户发 full 快照则整体取代全局。详见 semantic/overlay.py。
DMF_SEMANTIC-SOURCE=yaml
# 覆盖默认清单路径（目录或单文件）；空 = 内置 semantic/manifest.d
DMF_SEMANTIC-MANIFEST_DIR=
# 全局链指纹的节流探测窗口（秒，默认 1.0）：请求级装配下各实例靠它"拉"到别人发布的
# 快照 —— 窗口内共享一次轻查询，窗口外发现指纹变了就地重建基座（免广播、多实例自愈）。
# 0 = 每请求都探（最即时，但每请求多一条命中索引的查询）。
DMF_SEMANTIC-SCOPE_BASE_PROBE_TTL_S=1.0
# 切到 db 后，快照的建立/审批/热更新走：
#   POST /api/v1/semantic/registry/publish            （admin，默认落 draft）
#   POST /api/v1/semantic/registry/snapshots/{id}/submit    （semantic:write）
#   POST /api/v1/semantic/registry/snapshots/{id}/approve    （admin，通过后自动热更新）
#   GET  /api/v1/semantic/registry/runtime            （查看生效来源 / 版本链 / stale）
#   POST /api/v1/semantic/registry/reload             （admin，手动热更新）
