# 前端部署示例：nginx 反代 /api 到后端（前后端分离）
#
# 1. 构建：cd frontend && npm install && npm run build（产物在 frontend/dist）
# 2. 把 dist 部署到任意静态服务器，并反代 /api 到 DmfDataAgent 后端
#
# nginx 配置示例：
server {
    listen 80;
    server_name metrics.example.com;

    # 前端静态资源（构建产物）
    root /srv/frontend/dist;
    index index.html;

    # SPA 路由回退
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端 API 反代（含 SSE，关闭缓冲）
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;          # SSE 流式
        proxy_read_timeout 300s;
    }

    # 健康检查
    location = /health {
        proxy_pass http://127.0.0.1:8000/health;
    }
}
#
# 说明：若前端与后端跨域部署（非 nginx 反代），需在构建时设置
# VITE_API_BASE=<后端根地址>，并确保后端 CORS 允许前端域名
#（后端 DMF_APP-CORS_ORIGINS=* 默认放开）。
